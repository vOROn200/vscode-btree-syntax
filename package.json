{
  "name": "btree-syntax",
  "publisher": "vOROn200",
  "displayName": "Btree",
  "description": "Behaviour Tree DSL",
  "keywords": [
    "behaviour tree",
    "behavior tree",
    "btree",
    "bt",
    "dsl",
    "syntax highlighting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vOROn200/vscode-btree-syntax"
  },
  "bugs": {
    "url": "https://github.com/vOROn200/vscode-btree-syntax/issues"
  },
  "homepage": "https://github.com/vOROn200/vscode-btree-syntax#readme",
  "version": "0.1.11",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/logo.png",
  "contributes": {
    "languages": [
      {
        "id": "btree",
        "aliases": [
          "Btree",
          "btree"
        ],
        "extensions": [
          ".btree"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "btree",
        "scopeName": "source.btree",
        "path": "./syntaxes/btree.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build:grammar": "node scripts/build-grammar.js",
    "check:grammar": "node scripts/build-grammar.js --check",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "js-yaml": "^4.3.2"
  }
}
